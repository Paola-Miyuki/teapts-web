{
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "cacheDirectory": "<rootDir>/.jest-cache/e2e",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "clearMocks": true,
  "restoreMocks": true,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "useESM": true, "tsconfig": { "module": "ESNext" } }
    ]
  }
}
