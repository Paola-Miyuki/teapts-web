# API
PORT=3000
# PostgreSQL (porta local; no Compose usa 5432 internamente)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=teapts
# Preencha no .env. Nunca versione a senha
DATABASE_PASSWORD=
DATABASE_NAME=teapts

# SuperTokens: tag da imagem usada pelo docker-compose.yml.
# `latest` nao e reproduzivel. Fixe a versao em uso: suba a stack e rode
# `docker logs teapts-supertokens | head`, que imprime a versao do core no
# boot, ou veja github.com/supertokens/supertokens-core/releases.
SUPERTOKENS_VERSION=latest
